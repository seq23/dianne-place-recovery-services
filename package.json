{
  "name": "dianne-place-recovery-services",
  "version": "0.1.0",
  "private": true,
  "description": "Dianne's Place Recovery Services public site, admin surfaces, and governed content automation.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run content:generate-backlog && npm run content:self-produce && npm run release:state && npm run content:build-admin-manifest && npm run content:build-answers && npm run seo:build-sitemap && npm run seo:site-css && next build",
    "start": "next start",
    "lint": "eslint .",
    "content:generate-backlog": "node scripts/continuity/generate_backlog_preserving_future.mjs",
    "content:build-admin-manifest": "node scripts/content/build_admin_content_manifest.mjs",
    "content:build-answers": "node scripts/content/build_public_answer_feed.mjs",
    "seo:build-sitemap": "node scripts/seo/build_sitemap.mjs",
    "seo:site-css": "node scripts/seo/copy_site_css.mjs",
    "content:publish": "node scripts/content/publish_scheduled_content.mjs",
    "content:self-produce": "node scripts/content/self_produce_content.mjs && node scripts/continuity/harden_post_2026_item.mjs",
    "release:self-heal": "node scripts/release_self_heal.mjs",
    "validate:licensure-mode": "node scripts/validators/validate_licensure_mode.mjs",
    "validate:content": "node scripts/validators/validate_content.mjs",
    "validate:legal": "node scripts/validators/validate_legal.mjs",
    "validate:page-seo": "node scripts/validators/validate_page_seo.mjs",
    "validate:clarity": "node scripts/validators/validate_clarity.mjs",
    "validate:hard": "npm run validate:licensure-mode && npm run validate:content && npm run validate:legal && npm run validate:page-seo && npm run validate:clarity && npm run validate:authority-modernization",
    "validate:all": "npm run validate:hard",
    "validate:release": "npm run content:generate-backlog && npm run content:self-produce && npm run release:state && npm run content:build-admin-manifest && npm run content:build-answers && npm run seo:build-sitemap && npm run release:daily-proof && npm run release:self-heal && npm run validate:all",
    "release:daily-proof": "node scripts/content/build_daily_proof_packet.mjs",
    "release:plan": "node scripts/content/build_release_plan.mjs",
    "release:state": "node scripts/release/write_release_state.mjs",
    "authority:distribution": "node scripts/distribution/build_distribution_manifest.mjs",
    "distribution:submit": "node scripts/distribution/submit_distribution.mjs",
    "validate:protected-client-core": "node scripts/authority_scale/validate_protected_client_core.mjs",
    "validate:authority-modernization": "npm run validate:protected-client-core",
    "search:consolidation": "node scripts/search_intelligence/build_consolidation_candidates.mjs",
    "search:collect": "node scripts/search_intelligence/collect.mjs",
    "test:page-quality": "node --test scripts/tests/page-quality.test.mjs",
    "test:zero-paid": "node --test scripts/tests/zero-paid.test.mjs",
    "test:search-ops": "node --test scripts/tests/search-ops.test.mjs"
  },
  "dependencies": {
    "next": "14.2.23",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "eslint": "8.57.1",
    "eslint-config-next": "15.3.5",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
